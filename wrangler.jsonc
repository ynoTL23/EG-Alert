{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eg-alert",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  // Draws the embed image outside the Worker's CPU budget (src/collage.ts). The
  // Images Free plan needs no zone and allows 5,000 transformations a month; a
  // run uses 2-4 for a collage, or one per game for a slideshow, plus one.
  //
  // "remote" only affects `npm run dev`: Wrangler's local Images simulator has
  // no text(), so every label fails with "9523: expected image in request, got
  // null". Remote dev calls the account's real binding and spends real
  // transformations. Deploys ignore the flag.
  "images": { "binding": "IMAGES", "remote": true },
  // Settings for `wrangler preview`, which inherits neither bindings nor
  // observability from the top level. A Preview also gets its own
  // DISCORD_WEBHOOK_URL (`wrangler preview secret put`), never production's,
  // and never runs the cron: test it by fetching its URL.
  "previews": {
    "images": { "binding": "IMAGES" },
    "observability": { "enabled": true, "traces": { "enabled": true } }
  },
  "observability": {
    "enabled": true,
    // Traces record each subrequest (Epic, Discord) with status and
    // timing. On 2026-11-26 the logs could not show whether the Epic fetch was
    // a stale cache hit; a span would have.
    "traces": { "enabled": true }
  },
  "triggers": {
    // 16:15 UTC = 12:15 PM Eastern in summer, 11:15 AM in winter. Epic rotates
    // at 11:00 AM Eastern, which itself moves with DST (15:00 UTC in summer,
    // 16:00 UTC in winter), so winter is the tight side: 15 minutes of slack.
    // 16:01 raced the winter rotation and posted nothing on 2026-11-26.
    //
    // The weekday is spelled "THU", not a number: Cloudflare follows Quartz,
    // where 1 = Sunday and Thursday is 5 — not the 0 = Sunday convention most
    // cron systems use. "* * 4" here silently means Wednesday.
    "crons": ["15 16 * * THU"]
  }
}
