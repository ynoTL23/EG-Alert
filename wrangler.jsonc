{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eg-alert",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 16:15 UTC = 12:15 PM Eastern in summer, 11:15 AM in winter. Epic rotates
    // at 11:00 AM Eastern, which itself moves with DST (15:00 UTC in summer,
    // 16:00 UTC in winter), so winter is the tight side: 15 minutes of slack.
    // 16:01 raced the winter rotation and posted nothing on 2026-11-26.
    //
    // The weekday is spelled "THU", not a number: Cloudflare follows Quartz,
    // where 1 = Sunday and Thursday is 5 — not the 0 = Sunday convention most
    // cron systems use. "* * 4" here silently means Wednesday.
    "crons": ["15 16 * * THU"]
  }
}
