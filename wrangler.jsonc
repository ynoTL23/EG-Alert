{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eg-alert",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 16:01 UTC = 12:01 PM Eastern in summer, 11:01 AM in winter. Cloudflare
    // crons are UTC-only, so the local time drifts an hour across DST; noon is
    // late enough past Epic's ~11:00 ET rotation that either side has slack.
    //
    // The weekday is spelled "THU", not a number: Cloudflare follows Quartz,
    // where 1 = Sunday and Thursday is 5 — not the 0 = Sunday convention most
    // cron systems use. "* * 4" here silently means Wednesday.
    "crons": ["1 16 * * THU"]
  }
}
